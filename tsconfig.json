{
    "include": ["src/**/*.ts"],
    "compilerOptions": {
        "noImplicitAny": true,
        "strict": false,
        "skipLibCheck": true,
        "lib": ["es2017", "dom", "dom.iterable"],
        "module": "es2015",
        "moduleResolution": "node",
        "target": "es2017",
        "sourceMap": true
    },
    "typedocOptions": {
        "name": "StPageFlip",
        "out": "dist/docs",
        "readme": "none",
        "excludePrivate": true,
        "excludeProtected": true,
        "categorizeByGroup": true
    }
}
